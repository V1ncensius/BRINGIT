# URL dasar REST API backend (PHP). Contoh: http://localhost:8000/api
VITE_API_BASE_URL=/api
# true = pakai mock API di browser (tanpa backend). Ubah ke false bila backend siap.
VITE_USE_MOCK=true
# progress30 = hanya UC-01..UC-06 (Tim: Beranda, Profil, Cari lawan, Pertandingan).
# full = semua fitur tampil (Premium, Jasa, Penyedia, Admin) untuk progres berikutnya.
VITE_SCOPE=progress30
